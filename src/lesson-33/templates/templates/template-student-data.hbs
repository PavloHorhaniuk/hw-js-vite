{{#each students}}
<li class="student-card" data-index="{{@index}}">
    <div class="student-header">
        <div>
            <div class="student-name">{{firstName}} {{lastName}}</div>
            <div class="student-meta">
                Вік: {{age}} · Курс: {{course}} · Факультет: {{faculty}}
            </div>
        </div>
        <div class="actions">
            <button class="btn edit">Edit</button>
            <button class="btn danger delete">Delete</button>
        </div>
    </div>

    <div class="confirm hidden">
        <span>Видалити картку?</span>
        <button class="btn yes">Так</button>
        <button class="btn no">Ні</button>
    </div>
</li>
{{/each}}